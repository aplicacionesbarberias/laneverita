async function cobrar(btn) {
  const items = Object.entries(S.carrito).filter(([, c]) => c > 0).map(([id, c]) => ({producto_id:+id, cantidad:c}));
  if (!items.length) return;
  const total = sum(items, x => prod(x.producto_id).precio_venta * x.cantidad);
  btn.disabled = true; btn.textContent = 'Guardando…';
  try {
    await rpc('registrar_venta', {p_punto:S.pv, p_items:items});
    items.forEach(x => S.stock[S.pv + '-' + x.producto_id] = stk(S.pv, x.producto_id) - x.cantidad);
    S.carrito = {}; S.recibido = ''; S.cartOpen = false;
    toast('Venta registrada · ' + $$(total), 'ok');
    render(); recargar({silencioso:true});
  } catch (e) { toast(errMsg(e), 'bad'); btn.disabled = false; btn.textContent = 'Registrar venta'; recargar({silencioso:true}); }
}

