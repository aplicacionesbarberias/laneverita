  const filas = Object.values(porProd).sort((a, b) => b.t - a.t);
  const total = sum(V, v => v.total), unid = sum(filas, x => x.u);
  const liqs = S.dueno ? S.liqs.filter(l => !p || l.punto_id === p) : [];
  const SAL = S.salidas.filter(x => !p || x.punto_id === p), totSal = sum(SAL, x => x.monto);
