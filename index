function initCompras() {
  const f = $('#fCompra'); if (!f) return;
  const upd = () => {
    const paq = num(f.paq.value), upp = num(f.upp.value), pp = num(f.ppaq.value);
    const u = paq * upp, cu = upp ? pp / upp : 0;
    $('#cU').textContent = fmtN.format(u); $('#cCu').textContent = $$(cu); $('#cT').textContent = $$(paq * pp);
    $('#cSug').innerHTML = cu ? [20, 30, 40, 50].map(m => { const v = Math.ceil(cu * (1 + m/100) / 100) * 100; return `<button type="button" class="chip" data-a="sug" data-v="${v}">+${m}% → ${$$(v)}</button>`; }).join('') : '';
    const pv = num(f.pventa.value);
    $('#cGan').innerHTML = cu && pv ? (pv > cu ? `Ganas <b class="pos">${$$(pv - cu)}</b> por unidad (${pct(pv - cu, pv)}% del precio) · <b class="pos">${$$((pv - cu) * u)}</b> si vendes todo` : `<span class="neg">Ojo: vendes por debajo del costo</span>`) : '';
  };
  ['paq','upp','ppaq','pventa'].forEach(n => f[n].addEventListener('input', upd));
  f.prod.onchange = () => {
    $('#cNuevo').classList.toggle('hidden', f.prod.value !== 'nuevo');
    const x = prod(+f.prod.value); if (x && x.precio_venta) f.pventa.value = Math.round(x.precio_venta);
    if (f.prod.value === 'nuevo') f.nnombre.focus();
    upd();
  };
  f.onsubmit = async e => {
    e.preventDefault(); const btn = f.querySelector('button.big');
    let pid = f.prod.value;
    if (!pid) return toast('Elige el producto', 'bad');
    if (num(f.upp.value) <= 0 || num(f.paq.value) <= 0) return toast('Revisa paquetes y unidades', 'bad');
    btn.disabled = true; btn.textContent = 'Guardando…';
    try {
      if (pid === 'nuevo') {
        if (!f.nnombre.value.trim()) throw new Error('Escribe el nombre del producto nuevo');
        const r = await sb.from('productos').insert({nombre:f.nnombre.value.trim(), categoria:f.ncat.value.trim() || 'General', precio_venta:num(f.pventa.value)}).select().single();
        if (r.error) throw r.error; pid = r.data.id;
      }
      const hoy = ymd(new Date());
      await rpc('registrar_compra', {
        p_punto:+f.pt.value, p_producto:+pid, p_paquetes:Math.round(num(f.paq.value)), p_unidades_paquete:Math.round(num(f.upp.value)),
        p_precio_paquete:num(f.ppaq.value), p_precio_venta:num(f.pventa.value) || null,
        p_fecha: f.fecha.value === hoy ? new Date().toISOString() : new Date(parseYmd(f.fecha.value).setHours(12)).toISOString(),
        p_nota:f.nota.value.trim() || null, p_inicial:f.inicial.checked, p_salida:S.salidaSel
      });
      toast('Compra guardada y sumada al inventario', 'ok'); recargar();
    } catch (er) { toast(errMsg(er), 'bad'); btn.disabled = false; btn.textContent = 'Guardar compra'; }
  };
}

