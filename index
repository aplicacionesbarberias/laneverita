    <div class="kpi k-cost"><div class="t">Costo de lo vendido</div><div class="v num">${$$(R.costoV)}</div><div class="s">Lo que te costó lo que vendiste</div></div>
    <div class="kpi k-gan"><div class="t">Ganancia</div><div class="v num pos">${$$(R.ganancia)}</div><div class="s">Margen ${pct(R.ganancia, R.ventas)}% · Ventas − costo</div></div>
    <div class="kpi k-gas"><div class="t">Gastos</div><div class="v num neg">${$$(R.gastos)}</div><div class="s">${p ? 'Solo gastos de este punto' : 'Arriendo, hielo, etc.'}</div></div>
    <div class="kpi k-com"><div class="t">Inversión (compras)</div><div class="v num">${$$(R.compras)}</div><div class="s">Mercancía comprada en el periodo</div></div>
    <div class="kpi k-caja"><div class="t">Total en caja</div><div class="v num">${$$(K.total)}</div><div class="s">Base que queda + ventas (acumulado)</div></div>
