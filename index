/* ---------- cálculos ---------- */
function ventasVal(p = 0) { return S.ventas.filter(v => !v.anulada && (!p || v.punto_id === p)); }
function calc(p = 0) {
  const V = ventasVal(p);
  let ventas = 0, costoV = 0, unid = 0; const porProd = {}, porDia = {}, porPunto = {};
  for (const v of V) {
    ventas += +v.total;
    const pp = porPunto[v.punto_id] ||= {v:0, c:0, n:0, u:0}; pp.v += +v.total; pp.n++;
    const dk = ymd(v.fecha); const dd = porDia[dk] ||= {v:0, c:0};
    dd.v += +v.total;
    for (const it of v.venta_items || []) {
      const c = (S.vcost[it.id] ?? 0) * it.cantidad;
      costoV += c; unid += it.cantidad; pp.c += c; pp.u += it.cantidad; dd.c += c;
      const pr = porProd[it.producto_id] ||= {n:it.nombre, u:0, v:0, c:0};
      pr.u += it.cantidad; pr.v += +it.subtotal; pr.c += c;
    }
  }
  const G = S.gastos.filter(g => !p || g.punto_id === p);
  const C = S.compras.filter(c => !c.inicial && (!p || c.punto_id === p));
  const A = S.ajustes.filter(x => (!p || x.punto_id === p) && x.diferencia < 0);
  const gastos = sum(G, g => g.monto), compras = sum(C, c => c.total);
  const faltantes = sum(A, x => -x.diferencia * x.costo_unit);
  const ganancia = ventas - costoV;
  const utilidad = ganancia - gastos - faltantes;
  const baseP = sum(S.base, b => b.tipo === 'ingreso' ? b.monto : -b.monto) - sum(S.salidas.filter(x => x.tipo === 'otro'), x => x.monto);
  return { V, ventas, costoV, unid, ganancia, gastos, compras, faltantes, utilidad, baseP, porProd, porDia, porPunto, nVentas:V.length };
}
function caja() {
  const t = S.tot || {};
  const base = (+t.ingresos||0) - (+t.retiros||0);
  const queda = base - (+t.compras||0) - (+t.gastos||0);
  const ventasCaja = (+t.ventas||0) - (+t.salidas||0);
  return { base, compras:+t.compras||0, gastos:+t.gastos||0, ventas:+t.ventas||0, salidas:+t.salidas||0, ventasCaja, queda, total: queda + ventasCaja };
}

/* ---------- RESUMEN ---------- */
function vResumen() {
  const p = S.fPunto, R = calc(p), K = caja();
  // gráfico
  const {a, b} = rango(); const dias = Math.round((b - a) / 864e5);
  let barras = [];
  if (S.per.tipo === 'todo' || dias > 31) {
    const m = {}; Object.entries(R.porDia).forEach(([k, d]) => { const mk = k.slice(0,7); const x = m[mk] ||= {v:0,c:0}; x.v += d.v; x.c += d.c; });
    barras = Object.keys(m).sort().slice(-12).map(k => ({l: MESES[+k.slice(5,7)-1], ...m[k]}));
  } else {
    for (let i = 0; i < dias; i++) { const d = addDays(a, i), k = ymd(d); const x = R.porDia[k] || {v:0,c:0}; barras.push({l: dias <= 7 ? DIAS[d.getDay()] : d.getDate(), ...x}); }
  }
  const max = Math.max(1, ...barras.map(x => x.v));
  const chart = `<div class="chart">${barras.map(x => {
      const g = Math.max(0, x.v - x.c);
      return `<div class="bar" title="Ventas ${$$(x.v)} · Ganancia ${$$(g)}"><span class="n">${x.v ? (x.v >= 1000 ? fmtN.format(Math.round(x.v/1000)) + 'k' : fmtN.format(x.v)) : ''}</span>
      <div class="stack" style="height:${Math.max(2, x.v/max*130)}px"><div class="g" style="height:${x.v ? g/x.v*100 : 0}%"></div><div class="c" style="flex:1"></div></div>
      <span class="l">${x.l}</span></div>`; }).join('')}</div>
      <div class="legend"><span><i style="background:var(--ok)"></i>Ganancia</span><span><i style="background:#b9d6e6"></i>Costo de lo vendido</span></div>`;

  const top = Object.entries(R.porProd).sort((x, y) => y[1].v - x[1].v);
  const puntosVisibles = S.puntos.filter(pt => !p || pt.id === p);
  let invCosto = 0, invVenta = 0; const bajos = [];
