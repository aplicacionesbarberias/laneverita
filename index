        <label class="f">Categoría<select class="i" name="cat">${CATS_GASTO.map(c => `<option ${pf && pf.categoria === c ? 'selected' : ''}>${c}</option>`).join('')}</select></label>
        <label class="f">Valor<input class="i num" name="monto" inputmode="numeric" required placeholder="$0" value="${pf ? Math.round(pf.monto) : ''}"></label>
        <label class="f">¿Cuándo?<input class="i" type="date" name="fecha" value="${ymd(new Date())}"></label>
        <label class="f">¿Cómo se pagó?<select class="i" name="metodo">${METODOS.map(m => `<option>${m}</option>`).join('')}</select></label>
        <label class="f">¿De dónde salió la plata?<select class="i" name="pagado"><option value="base">De la base</option><option value="ventas">De lo vendido</option></select></label>
        <label class="f">Punto<select class="i" name="pt"><option value="">General (todo el negocio)</option>${S.puntos.map(p => `<option value="${p.id}">${esc(p.nombre)}</option>`).join('')}</select></label>
        <label class="f" style="flex-basis:100%">Nota<input class="i" name="nota" placeholder="A quién se le pagó, # de recibo… (opcional)"></label>
        <button class="btn big" style="flex-basis:100%">Guardar gasto</button>
      </form>
      ${Object.keys(porCat).length ? `<h3 style="margin-top:20px">Por categoría</h3>${Object.entries(porCat).sort((a, b) => b[1] - a[1]).map(([c, v]) => `<div class="li"><div class="m"><b>${esc(c)}</b><div style="height:6px;background:var(--bad-soft);border-radius:4px;margin-top:5px"><div style="height:6px;width:${pct(v, tot)}%;background:var(--bad);border-radius:4px"></div></div></div><div class="a num">${$$(v)}</div></div>`).join('')}` : ''}
    </div>
    <div class="card"><div class="row between"><h3 style="margin:0">Gastos del periodo</h3><b class="num neg">${$$(tot)}</b></div>
      ${G.length ? G.map(g => `<div class="li"><div class="m"><b>${esc(g.concepto)}</b>
        <span>${fFecha(g.fecha)} · ${esc(g.categoria)} · ${esc(g.metodo || 'Efectivo')} · ${g.pagado_con === 'ventas' ? 'de lo vendido' : 'de la base'} · ${esc(nombrePunto(g.punto_id))}${g.fijo_id ? ' · <span class="tag">fijo</span>' : ''}${g.nota ? '<br>' + esc(g.nota) : ''}</span></div>
        <div class="a num">${$$(g.monto)}</div><button class="ibtn" data-a="delGasto" data-v="${g.id}">${ic('trash')}</button></div>`).join('') : '<div class="empty">Sin gastos en este periodo</div>'}
    </div>
  </div>`;
}
function fechaISO(v) { return v === ymd(new Date()) ? new Date().toISOString() : new Date(parseYmd(v).setHours(12)).toISOString(); }
function initGastos() {
  const f = $('#fGasto'); if (!f) return;
  f.onsubmit = async e => {
    e.preventDefault(); const btn = f.querySelector('button.big'); btn.disabled = true;
    const r = await sb.from('gastos').insert({concepto:f.concepto.value.trim(), categoria:f.cat.value, punto_id:f.pt.value ? +f.pt.value : null,
      monto:num(f.monto.value), fecha:fechaISO(f.fecha.value), metodo:f.metodo.value, pagado_con:f.pagado.value, nota:f.nota.value.trim() || null, fijo_id:S.pagarFijo});
    if (r.error) { btn.disabled = false; return toast(errMsg(r.error), 'bad'); }
    S.pagarFijo = null; toast('Gasto guardado', 'ok'); recargar({catalogo:false});
  };
}
function mFijo(id) {
  const x = id ? S.fijos.find(f => f.id === id) : {concepto:'', categoria:'Arriendo', monto:'', dia_pago:1, activo:true};
  const ov = modal(`<h3>${id ? 'Editar' : 'Nuevo'} gasto fijo</h3>
    <form id="fFijo" class="row" style="gap:12px">
      <label class="f" style="flex-basis:100%">¿Qué es?<input class="i" name="concepto" required value="${esc(x.concepto)}" placeholder="Ej: Arriendo bodega"></label>
      <label class="f">Categoría<select class="i" name="cat">${CATS_GASTO.map(c => `<option ${x.categoria === c ? 'selected' : ''}>${c}</option>`).join('')}</select></label>
      <label class="f">Valor al mes<input class="i num" name="monto" inputmode="numeric" required value="${x.monto ? Math.round(x.monto) : ''}"></label>
      <label class="f">Día de pago<input class="i num" name="dia" inputmode="numeric" required value="${x.dia_pago}"></label>
      ${id ? `<label class="small chk" style="flex-basis:100%"><input type="checkbox" name="activo" ${x.activo ? 'checked' : ''}> Activo (si ya no lo pagas, quítale el chulo)</label>` : ''}
      <div class="acts" style="flex-basis:100%"><button type="button" class="btn line" data-a="close">Cancelar</button><button class="btn">Guardar</button></div>
    </form>`);
  ov.querySelector('#fFijo').onsubmit = async e => {
    e.preventDefault(); const f = e.target;
    const row = {concepto:f.concepto.value.trim(), categoria:f.cat.value, monto:num(f.monto.value), dia_pago:Math.min(31, Math.max(1, Math.round(num(f.dia.value))))};
    if (id) row.activo = f.activo.checked;
    const r = id ? await sb.from('gastos_fijos').update(row).eq('id', id) : await sb.from('gastos_fijos').insert(row);
    if (r.error) return toast(errMsg(r.error), 'bad');
    closeModal(); toast('Gasto fijo guardado', 'ok'); recargar({catalogo:false});
  };
}

/* ---------- BASE ---------- */
function vBase() {
  const K = caja(), B = S.base, R = calc(0);
  return `${periodoBar()}<h2>Manejo de la base</h2>
  <div class="hero">
    <div class="t">Te queda de la base</div>
    <div class="v num ${K.queda < 0 ? 'neg' : ''}">${$$(K.queda)}</div>
    <div class="s num">Base ${$$(K.base)} − Compras ${$$(K.compras)} − Gastos ${$$(K.gastos)} pagados con la base · desde el inicio</div>
  </div>
  <div class="kpis">
    <div class="kpi k-caja"><div class="t">Base registrada</div><div class="v num">${$$(K.base)}</div><div class="s">Capital que has metido</div></div>
    <div class="kpi k-com"><div class="t">Invertido en compras</div><div class="v num">${$$(K.compras)}</div><div class="s">${pct(K.compras, K.base)}% de la base</div></div>
    <div class="kpi k-gas"><div class="t">Gastos</div><div class="v num neg">${$$(K.gastos)}</div></div>
    <div class="kpi k-ventas"><div class="t">Ventas</div><div class="v num">${$$(K.ventas)}</div><div class="s">${K.salidas ? 'Menos ' + $$(K.salidas) + ' sacado de la caja = ' + $$(K.ventasCaja) : 'Plata que ha entrado'}</div></div>
    <div class="kpi k-gan"><div class="t">Total (queda + ventas en caja)</div><div class="v num">${$$(K.total)}</div><div class="s">Lo que debería haber en caja</div></div>
  </div>
  <div class="grid2">
    <div class="card"><h3>Registrar movimiento de base</h3>
      <form id="fBase" class="row" style="gap:12px">
        <div class="chips" style="flex-basis:100%"><label class="chip on" id="tIng"><input type="radio" name="tipo" value="ingreso" checked hidden>Meter base</label><label class="chip" id="tRet"><input type="radio" name="tipo" value="retiro" hidden>Sacar plata</label></div>
        <label class="f">Valor<input class="i num" name="monto" inputmode="numeric" required placeholder="$1.500.000"></label>
        <label class="f">Fecha<input class="i" type="date" name="fecha" value="${ymd(new Date())}"></label>
        <label class="f" style="flex-basis:100%">Nota<input class="i" name="nota" placeholder="Opcional"></label>
        <button class="btn big" style="flex-basis:100%">Guardar</button>
      </form>
      <div class="small muted" style="margin-top:14px">En este periodo (${rangoTxt()}): base ${$$(R.baseP)} · compras ${$$(R.compras)} · gastos ${$$(R.gastos)} · ventas ${$$(R.ventas)}</div>
    </div>
    <div class="card"><h3>Movimientos del periodo</h3>
      ${B.length ? B.map(b => `<div class="li"><div class="m"><b>${b.tipo === 'ingreso' ? 'Base ingresada' : 'Retiro'}</b><span>${fFecha(b.fecha)}${b.nota ? ' · ' + esc(b.nota) : ''}</span></div><div class="a num ${b.tipo==='ingreso'?'pos':'neg'}">${b.tipo==='ingreso'?'+':'−'}${$$(b.monto)}</div><button class="ibtn" data-a="delBase" data-v="${b.id}">${ic('trash')}</button></div>`).join('') : '<div class="empty">Sin movimientos en este periodo</div>'}
    </div>
  </div>`;
}
function initBase() {
  const f = $('#fBase'); if (!f) return;
  f.querySelectorAll('input[name=tipo]').forEach(r => r.onchange = () => { $('#tIng').classList.toggle('on', f.tipo.value === 'ingreso'); $('#tRet').classList.toggle('on', f.tipo.value === 'retiro'); });
  f.onsubmit = async e => {
    e.preventDefault();
    const r = await sb.from('base_movs').insert({tipo:f.tipo.value, monto:num(f.monto.value), fecha:fechaISO(f.fecha.value), nota:f.nota.value.trim() || null});
    if (r.error) return toast(errMsg(r.error), 'bad');
    toast('Movimiento guardado', 'ok'); recargar({catalogo:false});
  };
}

/* =====================================================================
   EVENTOS
   ===================================================================== */
function afterRender() {
  const b = $('#busq'); if (b) b.oninput = () => { S.busq = b.value; const pos = b.selectionStart; render(); const nb = $('#busq'); nb.focus(); nb.setSelectionRange(pos, pos); };
  const ib = $('#invBusq'); if (ib) ib.oninput = () => { S.invBusq = ib.value; const pos = ib.selectionStart; render(); const n = $('#invBusq'); n.focus(); n.setSelectionRange(pos, pos); };
  const ii = $('#invInact'); if (ii) ii.onchange = () => { S.invInact = ii.checked; render(); };
  const rc = $('#recibido'); if (rc) rc.oninput = () => {
    S.recibido = rc.value; const total = sum(Object.entries(S.carrito), ([id, c]) => (prod(+id)?.precio_venta || 0) * c), r = num(rc.value);
    $('#vuelto').innerHTML = r ? (r >= total ? `Vuelto: <b class="num pos">${$$(r - total)}</b>` : `<span class="neg">Faltan ${$$(total - r)}</span>`) : '';
  };
  const p1 = $('#pd1'), p2 = $('#pd2');
  if (p1) [p1, p2].forEach(x => x.onchange = () => { S.per.d1 = p1.value; S.per.d2 = p2.value; recargar({catalogo:false}); });
  initCompras(); initGastos(); initBase();
}

document.addEventListener('click', async e => {
  const el = e.target.closest('[data-a]'); if (!el) return;
  const a = el.dataset.a, v = el.dataset.v;
  switch (a) {
    case 'tab': S.tab = v; guardarUI(); render(); window.scrollTo(0, 0); break;
    case 'refresh': recargar(); break;
    case 'salir': salir(); break;
    case 'pin': mPin(); break;
    case 'close': closeModal(); break;
    case 'per': S.per.tipo = v; if (v === 'rango' && !S.per.d1) { const {a:x, b:y} = rango(); S.per.d1 = ymd(x); S.per.d2 = ymd(addDays(y, -1)); } render(); recargar({catalogo:false}); break;
    case 'fpunto': S.fPunto = +v; render(); break;
    case 'pv': S.pv = +v; S.carrito = {}; guardarUI(); render(); break;
    case 'cat': S.cat = v; render(); break;
    case 'add': { const id = +v, en = S.carrito[id] || 0;
      if (en >= stk(S.pv, id)) { toast(stk(S.pv, id) ? 'No hay más unidades de ese producto' : 'Producto agotado en este punto', 'bad'); break; }
      S.carrito[id] = en + 1; if (navigator.vibrate) navigator.vibrate(15); render(); break; }
    case 'menos': { const id = +v; S.carrito[id] = (S.carrito[id] || 0) - 1; if (S.carrito[id] <= 0) delete S.carrito[id]; render(); break; }
    case 'vaciar': S.carrito = {}; S.recibido = ''; render(); break;
    case 'cartToggle': S.cartOpen = !S.cartOpen; render(); break;
    case 'cobrar': cobrar(el); break;
    case 'nuevoProd': mProducto(); break;
    case 'editProd': mProducto(+v); break;
    case 'traslado': mTraslado(+v); break;
    case 'conteo': mConteo(); break;
    case 'conteoPt': mConteo(+v); break;
    case 'sug': { const f = $('#fCompra'); f.pventa.value = v; f.pventa.dispatchEvent(new Event('input')); break; }
    case 'anular':
      if (!await confirmar('¿Anular esta venta? Las unidades vuelven al inventario.', 'Anular venta', true)) break;
      try { await rpc('anular_venta', {p_id:+v}); toast('Venta anulada', 'ok'); recargar(); } catch (er) { toast(errMsg(er), 'bad'); } break;
    case 'delCompra':
      if (!await confirmar('¿Borrar esta compra? Las unidades se sacan del inventario.', 'Borrar', true)) break;
      try { await rpc('eliminar_compra', {p_id:+v}); toast('Compra borrada', 'ok'); recargar(); } catch (er) { toast(errMsg(er), 'bad'); } break;
    case 'delGasto': case 'delBase': case 'delLiq': {
      if (!await confirmar('¿Borrar este registro?', 'Borrar', true)) break;
      const t = {delGasto:'gastos', delBase:'base_movs', delLiq:'liquidaciones'}[a];
      const r = await sb.from(t).delete().eq('id', +v); if (r.error) toast(errMsg(r.error), 'bad'); else { toast('Borrado', 'ok'); recargar({catalogo:false}); } break; }
    case 'liquidar': mLiquidar(); break;
    case 'nuevoFijo': mFijo(); break;
    case 'editFijo': mFijo(+v); break;
    case 'pagarFijo': S.pagarFijo = +v; render(); $('#fGasto')?.scrollIntoView({behavior:'smooth', block:'center'}); break;
    case 'cancelFijo': S.pagarFijo = null; render(); break;
    case 'salida': mSalida(); break;
    case 'delSalida':
      if (!await confirmar('¿Borrar esta salida de caja?', 'Borrar', true)) break;
      try { await rpc('borrar_salida', {p_id:+v}); toast('Borrada', 'ok'); recargar({catalogo:false}); } catch (er) { toast(errMsg(er), 'bad'); } break;
    case 'regSalida': S.salidaSel = +v; render(); $('#fCompra')?.scrollIntoView({behavior:'smooth'}); break;
    case 'cancelSalida': S.salidaSel = null; render(); break;
    case 'listoSalida': {
      const r = await sb.from('salidas_caja').update({estado:'listo'}).eq('id', +v);
      if (r.error) toast(errMsg(r.error), 'bad'); else { if (S.salidaSel === +v) S.salidaSel = null; toast('Compra completa', 'ok'); recargar({catalogo:false}); } break; }
    case 'copiar': { const t = textoLiquidacion();
      try { await navigator.clipboard.writeText(t); toast('Resumen copiado', 'ok'); }
      catch { modal(`<h3>Copia el resumen</h3><textarea class="i" rows="12">${esc(t)}</textarea><div class="acts"><button class="btn" data-a="close">Listo</button></div>`); } break; }
    case 'wa': window.open('https://wa.me/?text=' + encodeURIComponent(textoLiquidacion()), '_blank'); break;
  }
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
window.addEventListener('focus', () => { if (S.user && S.loaded) recargar({silencioso:true}); });

iniciar();
</script>
</body>
</html>
