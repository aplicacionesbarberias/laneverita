const costo = pid => +S.costos[pid] || 0;

function inicioMes() { const h = new Date(); return new Date(h.getFullYear(), h.getMonth(), 1); }
function estadoFijos() {
  const hoy = new Date().getDate(), finMes = new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0).getDate();
  return S.fijos.filter(f => f.activo).map(f => {
    const pago = S.gastosMes.filter(g => g.fijo_id === f.id).sort((a, b) => b.fecha.localeCompare(a.fecha))[0];
    const dia = Math.min(f.dia_pago, finMes);
    return { f, pago, dia, vencido: !pago && hoy >= dia, faltan: dia - hoy };
  });
}
function rango() {
  const t = S.per.tipo, hoy = d0(new Date());
  let a, b;
  if (t === 'hoy') { a = hoy; b = addDays(hoy, 1); }
  else if (t === 'semana' || t === 'semana_ant') {
    a = addDays(hoy, -((hoy.getDay() + 6) % 7)); if (t === 'semana_ant') a = addDays(a, -7); b = addDays(a, 7);
  }
  else if (t === 'mes') { a = new Date(hoy.getFullYear(), hoy.getMonth(), 1); b = new Date(hoy.getFullYear(), hoy.getMonth()+1, 1); }
  else if (t === 'todo') { a = new Date(2020, 0, 1); b = addDays(hoy, 1); }
  else { a = S.per.d1 ? parseYmd(S.per.d1) : hoy; b = addDays(S.per.d2 ? parseYmd(S.per.d2) : hoy, 1); }
  return {a, b};
}
function rangoTxt() {
  const {a, b} = rango(); const z = addDays(b, -1);
  if (S.per.tipo === 'todo') return 'Desde el inicio';
  return ymd(a) === ymd(z) ? fFecha(a) : `${fFecha(a)} – ${fFecha(z)}`;
}

