const configurado = !CONFIG.SUPABASE_URL.includes('PEGA_AQUI');
const sb = configurado ? supabase.createClient(CONFIG.SUPABASE_URL, CONFIG.SUPABASE_KEY) : null;

async function all(build) {
  const out = []; let from = 0;
  for (;;) {
    const { data, error } = await build().range(from, from + 999);
    if (error) throw error;
    out.push(...data); if (data.length < 1000) break; from += 1000;
  }
  return out;
}
async function rpc(fn, args) {
  const { data, error } = await sb.rpc(fn, args);
  if (error) throw error; return data;
}

async function cargarCatalogo() {
  const [pts, prods, st] = await Promise.all([
    all(() => sb.from('puntos').select('*').order('id')),
    all(() => sb.from('productos').select('*').order('nombre')),
    all(() => sb.from('stock').select('*'))
  ]);
  S.puntos = pts; S.productos = prods;
  S.stock = {}; st.forEach(r => S.stock[r.punto_id + '-' + r.producto_id] = r.cantidad);
  if (S.dueno) {
    const c = await all(() => sb.from('productos_costo').select('*'));
    S.costos = {}; c.forEach(r => S.costos[r.producto_id] = +r.costo_unitario);
  }
}
async function cargarPeriodo() {
  const {a, b} = rango(); const A = a.toISOString(), B = b.toISOString();
  const rng = q => q.gte('fecha', A).lt('fecha', B).order('fecha', {ascending:false});
  const tareas = [all(() => rng(sb.from('ventas').select('*, venta_items(*)'))), all(() => rng(sb.from('salidas_caja').select('*')))];
  if (S.dueno) tareas.push(
    all(() => rng(sb.from('venta_costos').select('item_id,costo_unit,fecha'))),
    all(() => rng(sb.from('compras').select('*'))),
    all(() => rng(sb.from('gastos').select('*'))),
    all(() => rng(sb.from('base_movs').select('*'))),
    all(() => rng(sb.from('ajustes').select('*'))),
    all(() => rng(sb.from('liquidaciones').select('*'))),
    rpc('totales_base'),
    all(() => sb.from('gastos_fijos').select('*').order('dia_pago')),
    all(() => sb.from('gastos').select('*').not('fijo_id', 'is', null).gte('fecha', inicioMes().toISOString()))
  );
  const r = await Promise.all(tareas);
  S.ventas = r[0]; S.salidas = r[1];
  if (S.dueno) {
    S.vcost = {}; r[2].forEach(x => S.vcost[x.item_id] = +x.costo_unit);
    [S.compras, S.gastos, S.base, S.ajustes, S.liqs, S.tot, S.fijos, S.gastosMes] = r.slice(3);
  }
}
function guardarCache() {
  lsSet('nv-cache-' + S.user.id, {
    puntos:S.puntos, productos:S.productos, stock:S.stock, costos:S.costos, per:S.per,
    ventas:S.ventas, vcost:S.vcost, compras:S.compras, gastos:S.gastos, base:S.base, ajustes:S.ajustes, liqs:S.liqs, salidas:S.salidas, fijos:S.fijos, gastosMes:S.gastosMes, tot:S.tot
  });
}
let cargando = null;
async function recargar({catalogo=true, periodo=true, silencioso=false} = {}) {
  if (cargando) return cargando;
  S.busy = true; marcarSync();
  cargando = (async () => {
    try {
      await Promise.all([catalogo && cargarCatalogo(), periodo && cargarPeriodo()]);
      S.loaded = true; guardarCache(); render();
    } catch (e) { if (!silencioso) toast(errMsg(e), 'bad'); console.error(e); }
    finally { S.busy = false; cargando = null; marcarSync(); }
  })();
  return cargando;
}
function marcarSync() { const el = $('#sync'); if (el) el.className = 'sync' + (S.busy ? ' busy' : ''); }

let rtTimer;
function tiempoReal() {
  const ping = () => { clearTimeout(rtTimer); rtTimer = setTimeout(() => recargar({silencioso:true}), 700); };
  sb.channel('neverita')
    .on('postgres_changes', {event:'*', schema:'public', table:'stock'}, ping)
    .on('postgres_changes', {event:'*', schema:'public', table:'ventas'}, ping)
    .on('postgres_changes', {event:'*', schema:'public', table:'productos'}, ping)
    .on('postgres_changes', {event:'*', schema:'public', table:'salidas_caja'}, ping)
    .subscribe();
}

