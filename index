  safe:'<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="12" cy="12" r="3.5"/><path d="M12 8.5V10M7 20v1M17 20v1"/>',
  refresh:'<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>',
  out:'<path d="M15 4h4v16h-4M10 17l5-5-5-5M15 12H3"/>',
  plus:'<path d="M12 5v14M5 12h14"/>',
  edit:'<path d="M4 20h4L19 9l-4-4L4 16z"/>',
  swap:'<path d="M7 4L3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7"/>',
  check:'<path d="M9 11l3 3 8-8"/><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9"/>',
  trash:'<path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>',
  x:'<path d="M6 6l12 12M18 6L6 18"/>',
  wa:'<path d="M4 20l1.3-4A8 8 0 1 1 8.6 19z"/><path d="M9 9.5c.5 2 2 3.6 4.5 4.5l1.2-1.2 2 .9c-.3 1.3-1.3 2-2.5 1.8C11 15 8.8 12.8 8.2 10c-.2-1.2.5-2.2 1.8-2.5l.9 2z"/>',
  copy:'<rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/>',
  up:'<path d="M18 15l-6-6-6 6"/>'
};
const ic = (n, s='') => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ${s}>${ICON[n]||''}</svg>`;
const LOGO = (w=34) => `<svg width="${w}" height="${w}" viewBox="0 0 64 64"><rect x="14" y="4" width="36" height="56" rx="8" fill="#16a3d9"/><rect x="14" y="4" width="36" height="56" rx="8" fill="url(#lg)"/><defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#72d3f5"/><stop offset="1" stop-color="#16a3d9"/></linearGradient></defs><rect x="14" y="22" width="36" height="3" fill="#0b2a4a" opacity=".55"/><rect x="20" y="10" width="3" height="8" rx="1.5" fill="#fff"/><rect x="20" y="30" width="3" height="12" rx="1.5" fill="#fff"/><path d="M38 38l4 4m0-4l-4 4M40 36v8M36 40h8" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/></svg>`;

const TABS = {
  resumen:   ['Resumen',   'chart'],
  vender:    ['Vender',    'cart'],
  inventario:['Inventario','box'],
  ventas:    ['Ventas',    'receipt'],
  compras:   ['Compras',   'truck'],
  gastos:    ['Gastos',    'wallet'],
  base:      ['Base',      'safe']
};
const CATS_GASTO = ['Arriendo','Servicios','Transporte','Hielo','Bolsas / empaques','Pago trabajador','Otros'];
const METODOS = ['Efectivo','Nequi','Daviplata','Transferencia','Bre-B'];

/* ---------- utilidades ---------- */
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtN = new Intl.NumberFormat('es-CO', {maximumFractionDigits:0});
const $$ = n => (n < 0 ? '-$' : '$') + fmtN.format(Math.abs(Math.round(+n || 0)));
const num = v => { const n = parseFloat(String(v ?? '').replace(/\./g,'').replace(',', '.')); return isNaN(n) ? 0 : n; };
const pct = (a, b) => b ? Math.round(a / b * 100) : 0;
const addDays = (d, n) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };
const d0 = d => { const x = new Date(d); x.setHours(0,0,0,0); return x; };
const ymd = d => { const x = new Date(d); return `${x.getFullYear()}-${String(x.getMonth()+1).padStart(2,'0')}-${String(x.getDate()).padStart(2,'0')}`; };
const parseYmd = s => { const [y,m,d] = s.split('-').map(Number); return new Date(y, m-1, d); };
const DIAS = ['dom','lun','mar','mié','jue','vie','sáb'];
const MESES = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
const fFecha = d => { const x = new Date(d); return `${DIAS[x.getDay()]} ${x.getDate()} ${MESES[x.getMonth()]}`; };
const fHora = d => new Date(d).toLocaleTimeString('es-CO', {hour:'numeric', minute:'2-digit'});
const sum = (arr, f) => arr.reduce((a, x) => a + (+f(x) || 0), 0);
const lsGet = k => { try { return JSON.parse(localStorage.getItem(k)); } catch { return null; } };
const lsSet = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };

function toast(msg, type='') {
  const el = document.createElement('div'); el.className = 'tst ' + type; el.textContent = msg;
  $('#toast').appendChild(el); setTimeout(() => el.remove(), type === 'bad' ? 5000 : 2600);
}
function errMsg(e) {
  const m = e?.message || String(e);
  if (/Invalid login/i.test(m)) return 'Usuario o contraseña incorrectos';
  if (/Failed to fetch|NetworkError/i.test(m)) return 'Sin conexión a internet';
  return m;
}
function modal(html, cls='') {
  closeModal();
  const ov = document.createElement('div'); ov.className = 'ov'; ov.id = 'ov';
  ov.innerHTML = `<div class="modal ${cls}">${html}</div>`;
  ov.addEventListener('mousedown', e => { if (e.target === ov) closeModal(); });
  document.body.appendChild(ov);
  const f = ov.querySelector('input:not([type=hidden]),select'); if (f && window.innerWidth > 760) f.focus();
  return ov;
}
function closeModal() { $('#ov')?.remove(); }
function confirmar(msg, okTxt='Sí, continuar', danger=false) {
  return new Promise(res => {
    const ov = modal(`<h3>${msg}</h3><div class="acts"><button class="btn line" id="cNo">Cancelar</button><button class="btn ${danger?'danger':''}" id="cSi">${okTxt}</button></div>`);
    ov.querySelector('#cNo').onclick = () => { closeModal(); res(false); };
    ov.querySelector('#cSi').onclick = () => { closeModal(); res(true); };
  });
}

