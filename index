  await entrar(session.user);
}
async function entrar(user) {
  S.user = user;
  const { data, error } = await sb.from('perfiles').select('*').eq('id', user.id).maybeSingle();
  if (error || !data) { toast(error ? errMsg(error) : 'Tu usuario no tiene perfil. Corre el archivo SQL en Supabase.', 'bad'); await sb.auth.signOut(); return vistaLogin(); }
  S.perfil = data; S.dueno = data.rol === 'dueno';
  if (!S.dueno && !data.punto_id) { toast('Tu usuario no tiene punto asignado (usa punto1 o punto2).', 'bad'); await sb.auth.signOut(); return vistaLogin(); }
  const ui = lsGet('nv-ui-' + user.id) || {};
  S.tab = ui.tab && tabs().includes(ui.tab) ? ui.tab : (S.dueno ? 'resumen' : 'vender');
  S.pv = S.dueno ? (ui.pv || 1) : data.punto_id;
  const cache = lsGet('nv-cache-' + user.id);
  if (cache) { Object.assign(S, cache); S.loaded = true; }
  render();
  await recargar();
  tiempoReal();
}
