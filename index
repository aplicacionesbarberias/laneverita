    </form>`);
  const f = ov.querySelector('#fLq');
  const totPt = () => sum(ventasVal(+f.pt.value), v => v.total);
  const salPt = () => sum(S.salidas.filter(x => x.punto_id === +f.pt.value), x => x.monto);
  const debe = () => totPt() - salPt();
  const upd = () => { const d = num(f.ent.value) - debe(); ov.querySelector('#lqDif').innerHTML = f.ent.value ? (d === 0 ? '<span class="pos">Cuadra exacto</span>' : `<span class="${d<0?'neg':'pos'}">${d<0?'Faltan':'Sobran'} ${$$(Math.abs(d))}</span>`) : ''; };
  f.ent.value = Math.max(0, Math.round(debe())); upd(); f.ent.oninput = upd; f.pt.onchange = () => { f.ent.value = Math.max(0, Math.round(debe())); upd(); };
  f.onsubmit = async e => {
    e.preventDefault();
    const r = await sb.from('liquidaciones').insert({punto_id:+f.pt.value, desde:a.toISOString(), hasta:b.toISOString(), total:totPt(), salidas:salPt(), entregado:num(f.ent.value), nota:f.nota.value.trim() || null});
