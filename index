function textoLiquidacion() {
  const p = S.dueno ? S.fPunto : S.perfil.punto_id; const V = ventasVal(p); const pp = {};
  V.forEach(v => (v.venta_items||[]).forEach(it => { const x = pp[it.nombre] ||= {u:0, t:0}; x.u += it.cantidad; x.t += +it.subtotal; }));
  const lin = Object.entries(pp).sort((a, b) => b[1].t - a[1].t).map(([n, x]) => `• ${x.u} × ${n} = ${$$(x.t)}`);
  const SAL = S.salidas.filter(x => !p || x.punto_id === p), tv = sum(V, v => v.total), ts = sum(SAL, x => x.monto);
  const sal = SAL.length ? `\n\nSacado de la caja:\n${SAL.map(x => `• ${x.concepto} = −${$$(x.monto)}`).join('\n')}\n*DEBE ENTREGAR: ${$$(tv - ts)}*` : '';
  return `*${CONFIG.NOMBRE}*\nVentas ${p ? nombrePunto(p) : 'todos los puntos'}\n${rangoTxt()}\n\n${lin.join('\n')}\n\n*TOTAL VENDIDO: ${$$(tv)}* (${V.length} ventas)${sal}`;
}
function mLiquidar() {
  const pts = S.fPunto ? S.puntos.filter(p => p.id === S.fPunto) : S.puntos;
  const {a, b} = rango();
  const ov = modal(`<h3>Liquidar ventas</h3><p class="small muted" style="margin-top:-6px">${rangoTxt()}</p>
    <form id="fLq" class="row" style="gap:12px">
      <label class="f">Punto<select class="i" name="pt">${pts.map(p => `<option value="${p.id}">${esc(p.nombre)} — vendió ${$$(sum(ventasVal(p.id), v => v.total))}, debe entregar ${$$(sum(ventasVal(p.id), v => v.total) - sum(S.salidas.filter(x => x.punto_id === p.id), x => x.monto))}</option>`).join('')}</select></label>
