<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b2a4a">
<title>LA NEVERITA V&amp;A</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect x='14' y='4' width='36' height='56' rx='8' fill='%230b2a4a'/%3E%3Crect x='14' y='22' width='36' height='3' fill='%2372d3f5'/%3E%3Crect x='20' y='10' width='3' height='8' rx='1.5' fill='%2372d3f5'/%3E%3Crect x='20' y='30' width='3' height='12' rx='1.5' fill='%2372d3f5'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<style>
:root{
  --bg:#eef4f9; --card:#ffffff; --ink:#0d1b2a; --muted:#5b6b7c; --line:#dde6ef;
  --navy:#0b2a4a; --ice:#16a3d9; --ice-soft:#e3f4fb; --ok:#11875d; --ok-soft:#e2f5ec;
  --bad:#c8372d; --bad-soft:#fbe9e7; --warn:#b86e00; --warn-soft:#fff3dc; --accent:#ff6b3d;
  --r:16px; --sh:0 1px 2px rgba(13,27,42,.06),0 4px 14px rgba(13,27,42,.06);
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:Outfit,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;font-size:15px;line-height:1.4;-webkit-tap-highlight-color:transparent}
button,input,select,textarea{font:inherit;color:inherit}
.hidden{display:none!important}
label.chk{display:flex;gap:8px;align-items:flex-start;cursor:pointer}
label.chk input{margin-top:2px;flex:none}
.num{font-variant-numeric:tabular-nums}

/* ---------- header ---------- */
header{position:sticky;top:0;z-index:30;background:var(--navy);color:#fff;padding:10px 16px;display:flex;align-items:center;gap:12px;padding-top:max(10px,env(safe-area-inset-top))}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.brand svg{flex:none}
.brand b{font-weight:800;letter-spacing:.5px;font-size:17px;white-space:nowrap}
.brand small{display:block;font-size:11.5px;color:#9fd8ef;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
header .sp{flex:1}
.hbtn{background:rgba(255,255,255,.1);border:0;color:#fff;border-radius:10px;height:36px;min-width:36px;padding:0 10px;display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer}
.hbtn:hover{background:rgba(255,255,255,.18)}
.hbtn svg{width:18px;height:18px}

/* ---------- nav ---------- */
nav.tabs{display:flex;gap:4px;background:#fff;border-bottom:1px solid var(--line);padding:6px 12px;position:sticky;top:56px;z-index:25;overflow-x:auto}
nav.tabs button{border:0;background:none;padding:9px 14px;border-radius:10px;display:flex;align-items:center;gap:7px;color:var(--muted);font-weight:600;cursor:pointer;white-space:nowrap}
nav.tabs button svg{width:18px;height:18px}
nav.tabs button.on{background:var(--ice-soft);color:var(--navy)}
@media (max-width:760px){
  nav.tabs{position:fixed;top:auto;bottom:0;left:0;right:0;border-top:1px solid var(--line);border-bottom:0;padding:4px 4px max(4px,env(safe-area-inset-bottom));justify-content:space-around;gap:0;box-shadow:0 -4px 14px rgba(13,27,42,.06)}
  nav.tabs button{flex-direction:column;gap:2px;font-size:10.5px;padding:6px 4px;flex:1;min-width:0}
  nav.tabs button svg{width:21px;height:21px}
  main{padding-bottom:90px!important}
}

main{max-width:1180px;margin:0 auto;padding:16px}
h2{font-size:22px;margin:4px 0 12px;font-weight:700}
h3{font-size:16px;margin:0 0 10px;font-weight:700}
.card{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);padding:16px;margin-bottom:14px}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.between{justify-content:space-between}
.muted{color:var(--muted)}
.small{font-size:13px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media (max-width:860px){.grid2{grid-template-columns:1fr}}

/* ---------- controls ---------- */
.btn{border:0;border-radius:12px;padding:11px 16px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;background:var(--navy);color:#fff;transition:filter .15s}
.btn:hover{filter:brightness(1.12)}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.ice{background:var(--ice)}
.btn.ok{background:var(--ok)}
.btn.ghost{background:var(--ice-soft);color:var(--navy)}
.btn.line{background:#fff;color:var(--ink);border:1px solid var(--line)}
.btn.danger{background:var(--bad-soft);color:var(--bad)}
.btn.sm{padding:7px 11px;font-size:13px;border-radius:10px}
.btn.big{padding:15px 18px;font-size:17px;width:100%}
.btn svg{width:17px;height:17px}
.ibtn{border:1px solid var(--line);background:#fff;border-radius:9px;width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;color:var(--muted)}
.ibtn:hover{color:var(--navy);border-color:var(--ice)}
.ibtn svg{width:16px;height:16px}
label.f{display:flex;flex-direction:column;gap:5px;font-size:13px;color:var(--muted);font-weight:500;flex:1;min-width:130px}
input.i,select.i,textarea.i{border:1px solid var(--line);background:#fbfdff;border-radius:11px;padding:10px 12px;font-size:15px;color:var(--ink);width:100%;outline:none}
input.i:focus,select.i:focus,textarea.i:focus{border-color:var(--ice);box-shadow:0 0 0 3px rgba(22,163,217,.15);background:#fff}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:#fff;border-radius:999px;padding:7px 13px;font-size:13.5px;font-weight:600;cursor:pointer;color:var(--muted);white-space:nowrap}
.chip.on{background:var(--navy);border-color:var(--navy);color:#fff}
.scrollx{overflow-x:auto;-webkit-overflow-scrolling:touch}
.scrollx .chips{flex-wrap:nowrap}

/* ---------- period ---------- */
.period{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
.period .range{display:flex;gap:6px;align-items:center}
.period .range input{width:150px;padding:7px 10px}
.period .lbl{font-size:13px;color:var(--muted);margin-left:auto}

/* ---------- kpis ---------- */
.hero{background:linear-gradient(135deg,#0b2a4a 0%,#12487a 60%,#1679b0 100%);color:#fff;border-radius:20px;padding:20px;margin-bottom:14px;position:relative;overflow:hidden}
.hero .t{font-size:13.5px;color:#b9e6f7;font-weight:600;text-transform:uppercase;letter-spacing:.7px}
.hero .v{font-size:40px;font-weight:800;margin:4px 0;letter-spacing:-.5px}
.hero .s{font-size:14px;color:#d5eef8}
.hero .neg{color:#ffb3a8}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:12px;margin-bottom:14px}
.kpi{background:#fff;border-radius:var(--r);padding:14px;box-shadow:var(--sh);border-left:4px solid var(--line)}
.kpi .t{font-size:12.5px;color:var(--muted);font-weight:600;display:flex;align-items:center;gap:6px}
.kpi .v{font-size:23px;font-weight:700;margin-top:4px}
.kpi .s{font-size:12px;color:var(--muted);margin-top:2px}
.kpi.k-ventas{border-color:var(--ice)}.kpi.k-gan{border-color:var(--ok)}.kpi.k-gas{border-color:var(--bad)}
.kpi.k-com{border-color:var(--warn)}.kpi.k-caja{border-color:var(--navy)}.kpi.k-cost{border-color:#9aa8b6}
.pos{color:var(--ok)}.neg{color:var(--bad)}

/* ---------- tables ---------- */
table.t{width:100%;border-collapse:collapse;font-size:14px}
table.t th{text-align:left;font-size:12px;color:var(--muted);font-weight:600;padding:8px 8px;border-bottom:1px solid var(--line);white-space:nowrap}
table.t td{padding:9px 8px;border-bottom:1px solid #eef2f6;vertical-align:middle}
table.t tr:last-child td{border-bottom:0}
table.t .r{text-align:right}
table.t tfoot td{font-weight:700;border-top:2px solid var(--line)}
.tag{display:inline-block;font-size:11.5px;font-weight:700;padding:2px 8px;border-radius:999px;background:var(--ice-soft);color:var(--navy)}
.tag.bad{background:var(--bad-soft);color:var(--bad)}.tag.warn{background:var(--warn-soft);color:var(--warn)}.tag.ok{background:var(--ok-soft);color:var(--ok)}
.empty{padding:26px 10px;text-align:center;color:var(--muted)}

/* ---------- chart ---------- */
.chart{display:flex;align-items:flex-end;gap:6px;height:180px;padding-top:10px}
.bar{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;min-width:0;height:100%;justify-content:flex-end}
.bar .stack{width:100%;max-width:46px;display:flex;flex-direction:column;justify-content:flex-end;border-radius:7px 7px 3px 3px;overflow:hidden;background:#f1f5f9}
.bar .g{background:var(--ok)}
.bar .c{background:#b9d6e6}
.bar .l{font-size:11px;color:var(--muted);white-space:nowrap}
.bar .n{font-size:10.5px;color:var(--ink);font-weight:600;white-space:nowrap}
.legend{display:flex;gap:14px;font-size:12.5px;color:var(--muted);margin-top:10px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}

/* ---------- POS ---------- */
.pos-wrap{display:grid;grid-template-columns:1fr 340px;gap:14px;align-items:start}
.pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.prod{background:#fff;border:2px solid transparent;border-radius:14px;padding:12px;text-align:left;cursor:pointer;box-shadow:var(--sh);display:flex;flex-direction:column;gap:6px;min-height:112px;position:relative;transition:transform .08s}
.prod:active{transform:scale(.97)}
.prod.in{border-color:var(--ice)}
.prod .nm{font-weight:600;font-size:14.5px;line-height:1.25}
.prod .pr{font-size:18px;font-weight:800;color:var(--navy);margin-top:auto}
.prod .st{font-size:12px;color:var(--muted)}
.prod .st.low{color:var(--warn);font-weight:600}
.prod .qty{position:absolute;top:8px;right:8px;background:var(--ice);color:#fff;font-weight:800;border-radius:999px;min-width:26px;height:26px;display:flex;align-items:center;justify-content:center;font-size:13px;padding:0 7px}
.prod.off{opacity:.45;cursor:not-allowed}
.cart{position:sticky;top:120px}
.cline{display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #eef2f6}
.cline .nm{flex:1;font-size:14px;min-width:0}
.cline .nm small{display:block;color:var(--muted)}
.qbtn{width:30px;height:30px;border-radius:9px;border:1px solid var(--line);background:#fff;font-size:18px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center}
.ctot{display:flex;justify-content:space-between;align-items:baseline;margin:12px 0}
.ctot b{font-size:28px}
.cart-toggle{display:none}
@media (max-width:860px){.hide-m{display:none}}
@media (max-width:860px){
  .pos-wrap{grid-template-columns:1fr}
  .cart{position:fixed;left:0;right:0;bottom:62px;top:auto;margin:0;border-radius:18px 18px 0 0;z-index:20;box-shadow:0 -6px 24px rgba(13,27,42,.16);max-height:70vh;overflow:auto;padding:12px 16px}
  .cart .cbody{display:none}
  .cart.open .cbody{display:block}
  .cart-toggle{display:flex}
  .pos-pad{height:150px}
}

/* ---------- list items ---------- */
.li{display:flex;gap:12px;align-items:center;padding:11px 0;border-bottom:1px solid #eef2f6}
.li:last-child{border-bottom:0}
.li .m{flex:1;min-width:0}
.li .m b{display:block;font-weight:600}
.li .m span{font-size:13px;color:var(--muted)}
.li .a{font-weight:700;white-space:nowrap}
.li.anul{opacity:.5}
.li.anul .a{text-decoration:line-through}

.calc{background:var(--ice-soft);border-radius:14px;padding:14px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0}
.calc div{display:flex;flex-direction:column}
.calc small{font-size:12px;color:var(--muted);font-weight:600}
.calc b{font-size:20px;color:var(--navy)}
@media (max-width:520px){.calc{grid-template-columns:1fr 1fr}.calc div:last-child{grid-column:span 2}}

/* ---------- modal / toast ---------- */
.ov{position:fixed;inset:0;background:rgba(9,22,38,.5);z-index:60;display:flex;align-items:center;justify-content:center;padding:16px;animation:fi .15s}
.modal{background:#fff;border-radius:20px;padding:20px;width:100%;max-width:480px;max-height:90vh;overflow:auto;animation:up .18s}
.modal.wide{max-width:680px}
.modal h3{font-size:19px;margin-bottom:14px}
.modal .acts{display:flex;gap:8px;justify-content:flex-end;margin-top:18px}
@keyframes fi{from{opacity:0}}
@keyframes up{from{transform:translateY(14px);opacity:0}}
#toast{position:fixed;left:50%;top:70px;transform:translateX(-50%);z-index:80;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none;width:calc(100% - 32px);max-width:420px}
.tst{background:var(--navy);color:#fff;padding:12px 16px;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.2);font-weight:600;animation:up .2s;text-align:center}
.tst.ok{background:var(--ok)}.tst.bad{background:var(--bad)}

/* ---------- login ---------- */
.login{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;background:radial-gradient(1200px 600px at 20% -10%,#1d7fb8 0%,transparent 60%),linear-gradient(160deg,#0b2a4a,#071a2f)}
.lbox{background:#fff;border-radius:24px;padding:28px 24px;width:100%;max-width:380px;box-shadow:0 20px 60px rgba(0,0,0,.35)}
.lbox .logo{display:flex;flex-direction:column;align-items:center;gap:8px;margin-bottom:20px;text-align:center}
.lbox .logo b{font-size:24px;font-weight:800;color:var(--navy);letter-spacing:.5px}
.lbox .logo span{color:var(--muted);font-size:14px}
.lbox form{display:flex;flex-direction:column;gap:12px}
.who-list{display:flex;flex-direction:column;gap:10px}
.who{display:flex;flex-direction:column;align-items:flex-start;gap:2px;border:2px solid var(--line);background:#fff;border-radius:16px;padding:14px 16px;cursor:pointer;text-align:left;width:100%}
.who:hover{border-color:var(--ice);background:var(--ice-soft)}
.who b{font-size:17px;color:var(--navy)}.who span{font-size:13px;color:var(--muted)}
.who.sel{flex-direction:row;justify-content:space-between;align-items:center;background:var(--ice-soft);border-color:var(--ice)}
.who.sel span{color:var(--ice);font-weight:600}
.dots{display:flex;justify-content:center;gap:14px;margin:22px 0}
.dots i{width:16px;height:16px;border-radius:50%;border:2px solid var(--navy);display:block}
.dots i.on{background:var(--navy)}
.dots.shake{animation:sh .35s}
@keyframes sh{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
.pad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.pad button{height:62px;border-radius:16px;border:0;background:#f0f5f9;font-size:24px;font-weight:700;color:var(--navy);cursor:pointer}
.pad button:active{background:var(--ice);color:#fff}
.loading{display:flex;align-items:center;justify-content:center;gap:10px;color:var(--muted);padding:40px}
.spin{width:22px;height:22px;border:3px solid var(--line);border-top-color:var(--ice);border-radius:50%;animation:sp 0.8s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
.sync{width:8px;height:8px;border-radius:50%;background:#4ade80;display:inline-block}
.sync.busy{background:#fbbf24;animation:pl 1s infinite}
@keyframes pl{50%{opacity:.3}}
</style>
</head>
<body>
<div id="app"><div class="login"><div class="spin"></div></div></div>
<div id="toast"></div>

<script>
/* =====================================================================
